<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'نظام الحسابات' %> — <%= company.name %></title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.rtl.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (currentUser) { %>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <% if (company.logo_data) { %>
        <img src="<%= company.logo_data %>" alt="logo" class="brand-logo">
      <% } else { %>
        <i class="fa-solid fa-building-columns"></i>
      <% } %>
      <span><%= company.name %></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% function can(key){ return currentUser.is_admin || currentUser.permissions.includes(key); } %>
        <li class="nav-item"><a class="nav-link" href="/">الرئيسية</a></li>
        <% if (can('purchases')) { %><li class="nav-item"><a class="nav-link" href="/purchases">المشتريات</a></li><% } %>
        <% if (can('expenses')) { %><li class="nav-item"><a class="nav-link" href="/expenses">المصروفات</a></li><% } %>
        <% if (can('sales')) { %><li class="nav-item"><a class="nav-link" href="/sales">المبيعات</a></li><% } %>
        <% if (can('receipts')) { %><li class="nav-item"><a class="nav-link" href="/receipts">استلام فلوس</a></li><% } %>
        <% if (can('treasury')) { %><li class="nav-item"><a class="nav-link" href="/treasury">الخزنة</a></li><% } %>
        <% if (can('accounts')) { %><li class="nav-item"><a class="nav-link" href="/accounts">شجرة الحسابات</a></li><% } %>
        <% if (can('users') || can('roles')) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">الإدارة</a>
          <ul class="dropdown-menu">
            <% if (can('users')) { %><li><a class="dropdown-item" href="/users">المستخدمين</a></li><% } %>
            <% if (can('roles')) { %><li><a class="dropdown-item" href="/roles">الأدوار والصلاحيات</a></li><% } %>
            <% if (can('settings')) { %><li><a class="dropdown-item" href="/settings">إعدادات الشركة</a></li><% } %>
          </ul>
        </li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            <i class="fa-regular fa-user"></i> <%= currentUser.full_name %> <small class="opacity-75">(<%= currentUser.role_name %>)</small>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/change-password">تغيير كلمة المرور</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST">
                <button class="dropdown-item text-danger" type="submit">تسجيل الخروج</button>
              </form>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>
<main class="container-fluid py-4 px-3 px-lg-5">
