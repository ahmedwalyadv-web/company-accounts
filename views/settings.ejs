<%- include('partials/header', { title: 'إعدادات الشركة' }) %>

<h4 class="fw-bold mb-4">إعدادات الشركة</h4>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-3">بيانات الشركة</h6>
        <form method="POST" action="/settings" enctype="multipart/form-data">
          <div class="mb-3 text-center">
            <img src="<%= companyRow.logo_data || 'https://via.placeholder.com/90?text=Logo' %>" class="mb-2" style="height:90px;width:90px;object-fit:contain;border-radius:12px;border:1px solid #eee;">
          </div>
          <div class="mb-3">
            <label class="form-label">شعار الشركة (لوجو)</label>
            <input type="file" name="logo" accept="image/*" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">اسم الشركة</label>
            <input type="text" name="name" class="form-control" required value="<%= companyRow.name %>">
          </div>
          <div class="mb-3">
            <label class="form-label">العملة</label>
            <input type="text" name="currency" class="form-control" required value="<%= companyRow.currency %>">
          </div>
          <hr>
          <div class="mb-2">
            <label class="form-label">مفتاح Anthropic API (لتفعيل المساعد الافتراضي)</label>
            <input type="password" name="anthropic_api_key" class="form-control" placeholder="<%= companyRow.anthropic_api_key ? '•••••••••••••••• (محفوظ بالفعل — سيبه فاضي عشان يفضل كما هو)' : 'sk-ant-...' %>">
            <small class="text-muted">
              سيب الحقل فاضي لو مش عايز تغيّر المفتاح المحفوظ. اكتب "-" وحفظ لو عايز تمسحه.
              المفتاح ده بيتاخد من <a href="https://console.anthropic.com" target="_blank" rel="noopener">console.anthropic.com</a>.
            </small>
          </div>
          <button type="submit" class="btn btn-primary">حفظ</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card">
      <div class="card-body p-4">
        <h6 class="fw-bold mb-3">أسباب الصرف (تستخدم في المصروفات)</h6>
        <form method="POST" action="/settings/reasons" class="d-flex gap-2 mb-3">
          <input type="text" name="name" class="form-control" placeholder="سبب جديد.. مثال: مرتبات" required>
          <button type="submit" class="btn btn-primary text-nowrap">إضافة</button>
        </form>
        <ul class="list-group">
          <% reasons.forEach(r => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span class="<%= r.active ? '' : 'text-muted text-decoration-line-through' %>"><%= r.name %></span>
              <div class="d-flex gap-1">
                <form action="/settings/reasons/<%= r.id %>/toggle" method="POST">
                  <button class="btn btn-sm <%= r.active ? 'btn-outline-secondary' : 'btn-outline-success' %>">
                    <%= r.active ? 'إخفاء' : 'إظهار' %>
                  </button>
                </form>
                <form action="/settings/reasons/<%= r.id %>/delete" method="POST" onsubmit="return confirm('حذف السبب؟');">
                  <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>

<% if (currentUser.is_admin) { %>
<div class="card mt-4 border-danger">
  <div class="card-body p-4">
    <h6 class="fw-bold text-danger mb-3"><i class="fa-solid fa-triangle-exclamation"></i> منطقة خطر — إدارة/مسح البيانات</h6>
    <p class="text-muted small">
      الأدوات دي بتمسح حركات فعلية من قاعدة البيانات بشكل نهائي ومش رجعة فيه. اليوزرز والأدوار وشجرة الحسابات وإعدادات الشركة وأسباب الصرف مش بيتأثروا.
    </p>

    <% if (resetError) { %><div class="alert alert-danger"><%= resetError %></div><% } %>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="border rounded p-3 h-100">
          <h6 class="fw-bold mb-2">تصفير كامل لكل الحركات</h6>
          <p class="small text-muted">
            بيمسح: كل المشتريات والمبيعات وبنودها، المصروفات، استلام الفلوس، حركة الخزنة، المخزون والأصناف،
            العملاء، الموردين، وسجلات التقفيل الشهري وتسوية الخزنة. ويرجّع الترقيم التلقائي للصفر.
          </p>
          <form method="POST" action="/settings/reset-data/full"
                onsubmit="return confirm('متأكد تمامًا؟ الخطوة دي مش رجعة فيها وهتمسح كل الحركات نهائيًا.');">
            <div class="mb-2">
              <label class="form-label small">اكتب "مسح البيانات" بالحروف للتأكيد</label>
              <input type="text" name="confirm_text" class="form-control" placeholder="مسح البيانات" required>
            </div>
            <button type="submit" class="btn btn-danger w-100"><i class="fa-solid fa-trash"></i> تصفير كل البيانات</button>
          </form>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="border rounded p-3 h-100">
          <h6 class="fw-bold mb-2">مسح جزئي (اختار الموديولات)</h6>
          <p class="small text-muted">لو مسحت مشتريات أو مبيعات، حركة المخزون المرتبطة بيها بترجع صحيحة تلقائيًا.</p>
          <form method="POST" action="/settings/reset-data/partial"
                onsubmit="return confirm('متأكد من مسح الموديولات المحددة؟ الخطوة دي مش رجعة فيها.');">
            <div class="row row-cols-2 g-2 mb-3">
              <% Object.entries(moduleLabels).forEach(([key, label]) => { %>
                <div class="col">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="modules" value="<%= key %>" id="mod-<%= key %>">
                    <label class="form-check-label small" for="mod-<%= key %>"><%= label %></label>
                  </div>
                </div>
              <% }) %>
            </div>
            <div class="mb-2">
              <label class="form-label small">اكتب "مسح البيانات" بالحروف للتأكيد</label>
              <input type="text" name="confirm_text" class="form-control" placeholder="مسح البيانات" required>
            </div>
            <button type="submit" class="btn btn-outline-danger w-100"><i class="fa-solid fa-eraser"></i> مسح المحدد فقط</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
