<%- include('../partials/header', { title: 'المبيعات' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0">المبيعات</h4>
  <a href="/sales/new" class="btn btn-primary"><i class="fa-solid fa-plus"></i> فاتورة بيع/إيجار جديدة</a>
</div>

<% if (error) { %>
  <div class="alert alert-warning"><i class="fa-solid fa-lock"></i> <%= error %></div>
<% } %>

<div class="card mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <span class="text-muted">إجمالي المبيعات (كل الشهور)</span>
    <h5 class="fw-bold mb-0"><%= Number(total).toLocaleString('ar-EG') %> <%= company.currency %></h5>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>التاريخ</th>
            <th>العميل</th>
            <th>النوع</th>
            <th>الأصناف</th>
            <th>طريقة التحصيل</th>
            <th>استلمها / الحساب</th>
            <th>الإجمالي</th>
            <th>بواسطة</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
            <tr>
              <td><%= new Date(r.entry_date).toLocaleDateString('ar-EG') %></td>
              <td><%= r.customer_name || r.party %></td>
              <td>
                <% if (r.sale_type === 'rental') { %><span class="badge bg-info">إيجار</span>
                <% } else { %><span class="badge bg-primary">بيع</span><% } %>
              </td>
              <td><small><%= r.items_summary || '-' %></small></td>
              <td><span class="badge bg-secondary"><%= paymentLabels[r.payment_method] || r.payment_method %></span></td>
              <td><%= r.payment_method === 'bank' ? (r.account_name || '-') : (r.received_by_name || '-') %></td>
              <td class="fw-bold"><%= Number(r.amount).toLocaleString('ar-EG') %> <%= company.currency %></td>
              <td><small class="text-muted"><%= r.created_by_name || '-' %></small></td>
              <td class="text-nowrap">
                <a href="/sales/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-pen"></i></a>
                <form action="/sales/<%= r.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('متأكد من حذف الفاتورة؟ لو كانت بيع هيترجع للمخزون تلقائيًا.');">
                  <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (rows.length === 0) { %>
            <tr><td colspan="9" class="text-center text-muted py-4">لسه مفيش فواتير مسجلة في الشهر الحالي</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
