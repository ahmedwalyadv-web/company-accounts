<%- include('partials/header', { title: 'شجرة الحسابات' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0">شجرة الحسابات</h4>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newAccountModal">
    <i class="fa-solid fa-plus"></i> إضافة حساب
  </button>
</div>

<div class="card">
  <div class="card-body">
    <% function renderNode(node, depth) { %>
      <div style="padding-<%= depth === 0 ? '' : 'right' %>: <%= depth * 28 %>px" class="d-flex justify-content-between align-items-center py-2 border-bottom">
        <div>
          <i class="fa-regular fa-folder<%= node.children.length ? '-open' : '' %> text-warning me-1"></i>
          <strong><%= node.name %></strong>
          <span class="badge bg-light text-dark border ms-2"><%= node.type %></span>
          <% if (node.code) { %><small class="text-muted ms-2">#<%= node.code %></small><% } %>
        </div>
        <form action="/accounts/<%= node.id %>/delete" method="POST" onsubmit="return confirm('متأكد من حذف الحساب؟');">
          <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
        </form>
      </div>
      <% node.children.forEach(c => { renderNode(c, depth + 1); }) %>
    <% } %>
    <% tree.forEach(n => renderNode(n, 0)) %>
    <% if (tree.length === 0) { %>
      <p class="text-muted text-center py-3">لسه مفيش حسابات، ابدأ بإضافة حساب جديد</p>
    <% } %>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="newAccountModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/accounts">
        <div class="modal-header">
          <h5 class="modal-title">إضافة حساب جديد</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">اسم الحساب</label>
            <input type="text" name="name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">كود الحساب (اختياري)</label>
            <input type="text" name="code" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">نوع الحساب</label>
            <select name="type" class="form-select">
              <option value="asset">أصول</option>
              <option value="liability">خصوم</option>
              <option value="equity">حقوق ملكية</option>
              <option value="revenue">إيرادات</option>
              <option value="expense">مصروفات</option>
              <option value="other">أخرى</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">الحساب الأب (اختياري)</label>
            <select name="parent_id" class="form-select">
              <option value="">-- حساب رئيسي --</option>
              <% allAccounts.forEach(a => { %>
                <option value="<%= a.id %>"><%= a.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">حفظ</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
