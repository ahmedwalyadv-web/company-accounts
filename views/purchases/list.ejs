<%- include('../partials/header', { title: 'المشتريات' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="fw-bold mb-0">المشتريات</h4>
  <a href="/purchases/new" class="btn btn-primary"><i class="fa-solid fa-plus"></i> فاتورة شراء جديدة</a>
</div>

<% if (error) { %>
  <div class="alert alert-warning"><i class="fa-solid fa-lock"></i> <%= error %></div>
<% } %>

<div class="card mb-3">
  <div class="card-body d-flex justify-content-between align-items-center">
    <span class="text-muted">إجمالي المشتريات (كل الشهور)</span>
    <h5 class="fw-bold mb-0"><%= Number(total).toLocaleString('ar-EG') %> <%= company.currency %></h5>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>التاريخ</th>
            <th>المورد</th>
            <th>الأصناف</th>
            <th>طريقة الدفع</th>
            <th>دفعها</th>
            <th>الإجمالي</th>
            <th>بواسطة</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
            <tr>
              <td><%= new Date(r.entry_date).toLocaleDateString('ar-EG') %></td>
              <td><%= r.party %></td>
              <td>
                <small><%= r.items_summary || '-' %></small>
                <% if (Number(r.assets_count) > 0) { %>
                  <span class="badge bg-success ms-1"><%= r.assets_count %> أصل/جهاز</span>
                <% } %>
              </td>
              <td><span class="badge bg-secondary"><%= paymentLabels[r.payment_method] || r.payment_method %></span></td>
              <td><%= r.paid_by_name || '-' %></td>
              <td class="fw-bold"><%= Number(r.amount).toLocaleString('ar-EG') %> <%= company.currency %></td>
              <td><small class="text-muted"><%= r.created_by_name || '-' %></small></td>
              <td class="text-nowrap">
                <a href="/purchases/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-pen"></i></a>
                <form action="/purchases/<%= r.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('متأكد من حذف الفاتورة؟ لو فيها أجهزة/أصول هيتم خصمها من المخزون تلقائيًا.');">
                  <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (rows.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">لسه مفيش فواتير مسجلة في الشهر الحالي</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
